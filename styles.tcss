Screen {
    background: #070b12;
    color: #d7e2ef;
    layout: vertical;
}

#top-header {
    height: 3;
    padding: 0 1;
    background: #101a26;
    border-bottom: solid #ffcc00;
}

#header-title {
    width: 1fr;
    color: #00ffff;
    text-style: bold;
    content-align: left middle;
}

#wallet-header {
    width: auto;
    min-width: 28;
    color: #ffcc00;
    text-style: bold;
    content-align: right middle;
}

#main-layout {
    height: 1fr;
    padding: 1;
}

#pane-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 1fr;
    height: 1fr;
}

.pane {
    layout: vertical;
    padding: 0 1;
    background: #0b111b;
}

.pane-title {
    height: 2;
    text-style: bold;
    content-align: left middle;
}

.agent-pane RichLog,
#bus-pane RichLog {
    height: 1fr;
    min-height: 3;
    background: #080d15;
    scrollbar-color: #52657a;
}

#aura-pane {
    border: round #00ffff;
}

#aura-pane .pane-title,
#aura-status {
    color: #00ffff;
}

#ghost-pane {
    border: round #ff3366;
}

#ghost-pane .pane-title,
#ghost-status {
    color: #ff6688;
}

#gasparin-pane {
    border: round #00ff66;
}

#gasparin-pane .pane-title,
#gasparin-status {
    color: #00ff66;
}

#bus-pane {
    border: round #ffcc00;
}

#bus-pane .pane-title,
#bus-status {
    color: #ffcc00;
}

#aura-status,
#ghost-status,
#gasparin-status,
#bus-status {
    height: 1;
    text-style: dim;
}

#command-input {
    dock: bottom;
    height: 3;
    margin: 0 1 1 1;
    border: round #52657a;
    background: #101a26;
}

#command-input:focus {
    border: round #00ffff;
}
